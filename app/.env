# Flask Configuration
SECRET_KEY=your-super-secret-key-change-in-production-nairobi-2025
FLASK_ENV=development
FLASK_DEBUG=True

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=Aggregator_db

# Alternative: Use direct DATABASE_URI
DATABASE_URI=mysql+pymysql://root:@localhost/Aggregator_db?charset=utf8mb4

# Application Settings
NAIROBI_MARKET_ENABLED=True
DEFAULT_CURRENCY=KES
TIMEZONE=Africa/Nairobi